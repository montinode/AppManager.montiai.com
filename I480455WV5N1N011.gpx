/// Generate an identity matrix of size n.
/// An identity matrix is a square matrix with 1 on the main diagonal and 0 elsewhere.
fn identity_matrix(n: usize) -> Vec<Vec<i32>> {
    let mut mat = vec![vec![0; n]; n];
    for i in 0..n {
        mat[i][i] = 1;
    }
    mat
}

fn main() {
    // The name you provided – split by '^' to get individual parts.
    let name = "MONTI^JOHN^CHARLES^MONTI";
    let parts: Vec<&str> = name.split('^').collect();
    
    // Use the number of parts as the matrix dimension.
    // (You could also use the total character length, or a fixed size.)
    let n = parts.len();  // n = 4
    let identity = identity_matrix(n);

    // Print the identity matrix in a human‑readable way.
    println!("Identity matrix of size {} derived from '{}':", n, name);
    for row in &identity {
        // Format row as a string of numbers.
        let row_str: Vec<String> = row.iter().map(|&x| x.to_string()).collect();
        println!("[ {} ]", row_str.join(" "));
    }

    // Optional: show that each row corresponds to a name part.
    println!("\nCorrespondence:");
    for (i, part) in parts.iter().enumerate() {
        println!("Row {} : {}  (diagonal = 1)", i, part);
    }
}
